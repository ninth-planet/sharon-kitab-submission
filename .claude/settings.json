{
  "permissions": {
    "deny": [
      "mcp__supabase__apply_migration",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__create_edge_function_secret",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__create_edge_function_secret",
      "mcp__plugin_supabase_supabase__apply_migration",
      "mcp__plugin_supabase_supabase__deploy_edge_function",
      "mcp__plugin_supabase_supabase__create_edge_function_secret",
      "Bash(supabase functions deploy *)",
      "Bash(supabase secrets set *)",
      "Bash(supabase db push *)",
      "Bash(git push --force *)",
      "Bash(git push * main)",
      "Bash(git push origin main)"
    ],
    "ask": [
      "mcp__supabase__execute_sql",
      "mcp__Supabase__execute_sql",
      "mcp__plugin_supabase_supabase__execute_sql",
      "Bash(vercel *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/np-guard.sh", "timeout": 10, "onFailure": "block" }
        ]
      }
    ]
  }
}
